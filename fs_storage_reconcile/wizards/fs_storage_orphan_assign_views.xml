<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="fs_storage_orphan_assign_form" model="ir.ui.view">
        <field name="name">fs.storage.orphan.assign.form</field>
        <field name="model">fs.storage.orphan.assign</field>
        <field name="arch" type="xml">
            <form string="Assign to Record">
                <group>
                    <field name="orphan_id" readonly="1" />
                    <field name="name" />
                    <field name="res_model" />
                    <field name="res_id" />
                </group>
                <footer>
                    <button
                        name="action_assign"
                        string="Assign"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fs_storage_orphan_assign" model="ir.actions.act_window">
        <field name="name">Assign to Record</field>
        <field name="res_model">fs.storage.orphan.assign</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
